{
  "manifest_version": 3,
  "name": "TextCatch 화면캡쳐",
  "version": "1.0.0",
  "description": "텍스트 캐치 수신 메시지 화면의 URL 패널을 캡쳐합니다. (http 접속에서도 동작)",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://enfish.duckdns.org/*",
        "http://168.107.55.147/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
